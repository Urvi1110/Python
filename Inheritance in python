class BankAccount:
    def __init__(self,balance,name):
        self.name = name
        self.balance = balance
    def withdraw(self,amt):
        self.balance -= amt
    def deposit(self,amt):
        self.balance += amt
    def check_balance(self):
        print(self.balance)

class SavingAccount(BankAccount):
    def __init__(self, balance, name):
        super().__init__(balance, name)
    
