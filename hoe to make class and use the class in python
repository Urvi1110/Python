balance = 5000 
history = [f"starting balance {balance}"]
MAX_ATTEMPTS = 3
PASSWORD = "1234"
def withdraw(amount):
    global balance
    if amount > balance :
        print("insufficient balance")
    else:
        balance -= amount
        print(f"{amount} withdraw successfully")
        history.append(f"withdrawn{amount}") 
def deposit(amount):
    global balance
    if amount > 0:
        balance = balance + amount
        print(f"{amount} deposit successfully")
        history.append(f"deposited {amount}")
    else :
        print("Invalid amount")
def check_balance():
    return balance

authenticated = False
for attempt in range(MAX_ATTEMPTS):
    password = input(f"Enter the password (Attempt {attempt + 1} of {MAX_ATTEMPTS}): ")
    if password == PASSWORD:
        print("Password is correct!!")
        authenticated = True
        break
    else:
        remaining_attempts = MAX_ATTEMPTS - 1 - attempt
        if remaining_attempts > 0:
            print(f"Wrong password!! only {remaining_attempts} try left")
        else:
            print("Account is locked!!")

if authenticated == True:
    while True:
        print("""1.deposit
        2.withdraw
        3.check balance
        4.History
        5.exit""")
        n = int(input("enter your choice:"))

        if n == 1:
            amt = int(input("how much you want to deposite:"))
            deposit(amt)
        elif n == 2:
            amt = int(input("how much you want to withdraw:"))
            withdraw(amt)
        elif n == 3:
            print(check_balance())
        elif n == 4:
            print("\nTransaction History")
            for transaction in history:
                print(transaction)
        elif n == 5:
            break
        else:
            print("wrong choice!!")
