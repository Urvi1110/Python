class BankAccount:
    def __init__(self,name,balance):
        self.name = name
        self.balance = balance
    def deposit(self,amt):
        if amt >0 :
            self.balance += amt
            print(self.name,"deposited",amt)
        else :
            print("please enter valid amount")
    def withdraw(self,amt):
        if amt <= self.balance:
            self.balance -= amt
            print(self.name,"withdrawn",amt)
        else:
            print("Insufficient balance")
    def check_balance(self):
        print(self.name,"your balance is :",self.balance)
    def transfer(self,other_account,amt):
        print(self.name,"transfer",amt ,"to",other_account.name)
        self.balance -= amt
        other_account.balance += amt

